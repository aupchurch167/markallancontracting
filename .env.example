# Sanity — content source of truth.
# Fill from sanity.io/manage before go-live so authored content overrides the
# code fallbacks. Leave empty to run on the built-in fallback content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Site
NEXT_PUBLIC_SITE_URL=https://www.macont.com

# Optional: Calendly event link to show a site-walk scheduler on /contact.
# Leave empty to keep the phone as the only path.
NEXT_PUBLIC_CALENDLY_URL=

# Tracking — verified from the live macont.com. These are public client-side IDs,
# not secrets. The app falls back to these same values in lib/constants.ts, so
# setting them here is only needed to override (e.g. point staging elsewhere).
# CallRail DNI swap URL is /companies/<ID>/<SWAP>/swap.js.
NEXT_PUBLIC_CALLRAIL_ID=571875192
NEXT_PUBLIC_CALLRAIL_SWAP=8a72377554f5e3b406a8
NEXT_PUBLIC_GA4_ID=G-Z9YX6SX90M

# Seeding (server-side only — do NOT prefix with NEXT_PUBLIC). Create a write
# token at sanity.io/manage, then: npm run seed
SANITY_WRITE_TOKEN=

# On-demand revalidation. Set a random secret, then point a Sanity webhook at
# POST /api/revalidate?secret=… so publishing updates the live site in seconds.
SANITY_REVALIDATE_SECRET=

# ── /admin content console ────────────────────────────────────────────────
# Password-gated console at /admin for drafting blog posts and projects with
# Claude, saved straight into Sanity as drafts. All three are required for it
# to work; until they're set the console denies access and returns clear errors.

# Anthropic API key (server-side only). Powers draft generation from your
# brief + attached images/PDFs. Create one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Google Gemini — optional. Enables the "Generate cover" button (AI blog cover
# images, stored in R2). Leave empty to keep covers upload-only; the button then
# returns a clear "not configured" message. Key from aistudio.google.com.
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# The shared password to sign in at /admin.
ADMIN_PASSWORD=

# A long random string used to sign the admin session cookie (16+ chars).
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Cloudflare R2 (S3-compatible) — where /admin uploads (images + PDFs) are
# stored. The public URLs are written onto the draft and rendered directly.
# From the Cloudflare dashboard: R2 → your bucket → Settings (public access /
# custom domain) for the public URL, and R2 → Manage R2 API Tokens for the keys.
# S3_ENDPOINT may include the bucket path (…/mac-website); only the origin is used.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Public read base, no trailing slash. The r2.dev dev URL or a custom domain,
# e.g. https://pub-xxxxxxxx.r2.dev  or  https://media.macont.com
S3_PUBLIC_URL=
