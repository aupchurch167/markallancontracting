# Sanity — content source of truth.
# Fill from sanity.io/manage before go-live so authored content overrides the
# code fallbacks. Leave empty to run on the built-in fallback content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Site
NEXT_PUBLIC_SITE_URL=https://www.macont.com

# Tracking — verified from the live macont.com. These are public client-side IDs,
# not secrets. The app falls back to these same values in lib/constants.ts, so
# setting them here is only needed to override (e.g. point staging elsewhere).
# CallRail DNI swap URL is /companies/<ID>/<SWAP>/swap.js.
NEXT_PUBLIC_CALLRAIL_ID=571875192
NEXT_PUBLIC_CALLRAIL_SWAP=8a72377554f5e3b406a8
NEXT_PUBLIC_GA4_ID=G-Z9YX6SX90M

# Seeding (server-side only — do NOT prefix with NEXT_PUBLIC). Create a write
# token at sanity.io/manage, then: npm run seed
SANITY_WRITE_TOKEN=

# On-demand revalidation. Set a random secret, then point a Sanity webhook at
# POST /api/revalidate?secret=… so publishing updates the live site in seconds.
SANITY_REVALIDATE_SECRET=
